<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <!-- SQL Server cục bộ; sử dụng tài khoản Windows hiện tại, không lưu mật khẩu DB. -->
  <connectionStrings>
    <add name="LuaMocDB"
         connectionString="Server=.;Database=LuaMocDB;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;Connect Timeout=10;Application Name=Quan_Li_Nha_Hang_Suon_Muoi;"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
</configuration>
